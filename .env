RULE_WORKERS=5 # Sets the size of the simulation's default worker pool for updating particles, measured in threads (Fine Threading and Smart Parallelism are not bound by this pool)
PORT=8000 # Sets the port which the server will listen on, defaults to port 8000 if no value is set
MONITOR_PORT=8001 # Sets the port which the usage monitor's server will listen on, defaults to port 8001 if no value is set
HOST=0.0.0.0 # Sets the host to which the server will bind to, defaults to 0.0.0.0 if no value is set